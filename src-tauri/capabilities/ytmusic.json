{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "ytmusic-permissions",
  "description": "Autorise YouTube Music a changer le titre de la fenetre",
  "windows": [
    "main"
  ],
  "remote": {
    "urls": [
      "https://music.youtube.com/*"
    ]
  },
  "permissions": [
    "core:default",
    "opener:default",
    "core:window:allow-set-title"
  ]
}
